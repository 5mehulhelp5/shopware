{#
    Bare slider CMS element
    ===========================================
    @experimental
    @private

    A new bare metal slider component that uses the CSS scroll-snap feature, less JavaScript and no tiny-slider library.
#}

{% set componentName = 'cms-element-bare-slider' %}
{% set componentOptions = { componentName } %}
{% set cssOnly = false %}

{% set carouselComponent %}
<div
    class="{{ componentName }} row g-4{% if cssOnly %} is-css-only{% endif %}"
{#    data-bare-slider="true"#}
{#    data-bare-slider-options="{{ componentOptions|json_encode }}"#}
>

    {#
        Thumbnail previews
        ===========================================
    #}
    <div class="{{ componentName }}-thumbnails col-md-auto d-none d-md-block">
        {%- for image in element.data.sliderItems -%}
            <a href="#carousel-item-{{ loop.index }}" data-slide-to="{{ loop.index }}" class="{{ componentName }}-thumbnail-item{% if loop.index == 1 %} active{% endif %}">
                {%- sw_thumbnails 'gallery-slider-image-thumbnails' with {
                    media: image.media,
                    sizes: {
                        default: '70px'
                    },
                    attributes: {
                        loading: 'lazy',
                    }
                } -%}
            </a>
        {%- endfor -%}
    </div>

    <div class="col-md {{ componentName }}-items">
        {#
            Carousel items
            ===========================================
        #}
        <div class="{{ componentName }}-inner">
            {% for image in element.data.sliderItems %}
                <div class="{{ componentName }}-item" id="carousel-item-{{ loop.index }}">
                    {%- sw_thumbnails 'gallery-slider-image-thumbnails' with {
                        media: image.media,
                        autoColumnSizes: false,
                        attributes: {
                            loading: 'lazy',
                            'data-bs-toggle': 'modal',
                            'data-bs-target': "#gallery-modal",
                        }
                    } -%}
                </div>
            {% endfor %}
        </div>

        {#
            Arrow navigation
            ===========================================
        #}
        {% if not cssOnly %}
            <div class="{{ componentName }}-arrows">
                <button class="{{ componentName }}-arrow prev" type="button">
                    {% sw_icon 'arrow-left' style { size: 'sm' } %}
                </button>

                <button class="{{ componentName }}-arrow next" type="button">
                    {% sw_icon 'arrow-right' style { size: 'sm' } %}
                </button>
            </div>
        {% endif %}

        {#
            Dot navigation
            ===========================================
        #}
        <div class="{{ componentName }}-navigation">
            {% if not cssOnly %}
                {%- for image in element.data.sliderItems -%}
                    <a class="{{ componentName }}-navigation-item{% if loop.index == 1 %} active{% endif %}" href="#carousel-item-{{ loop.index }}" data-slide-to="{{ loop.index }}">
                        <span class="visually-hidden">{{ loop.index }}</span>
                    </a>
                {%- endfor -%}
            {% endif %}
        </div>
    </div>
</div>
{% endset %}

{{ carouselComponent }}

{#
    Full screen gallery
    ===========================================
#}
<div class="modal fade {{ componentName }}-preview-modal" id="gallery-modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <button type="button" class="btn-close position-absolute top-0 end-0 z-5 m-3" data-bs-dismiss="modal" aria-label="Close"></button>

            <div class="modal-body overflow-hidden">
                {{ carouselComponent }}
            </div>
        </div>
    </div>
</div>
