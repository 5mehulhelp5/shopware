{#
    Carousel CMS element
    ===========================================
    @experimental
    @private

    A new carousel (aka slider) component that uses the CSS scroll-snap feature, less JavaScript and no tiny-slider library.

    Properties:
    * carouselItems (required) - The items that will be shown in the carousel, for example images.
    * showArrowNav (optional) - Show prev and next buttons with arrows.
    * showDotNav (optional) - Show navigation dots underneath the carousel items.
#}

{% set carouselComponent %}
<div
    class="cms-block-image-carousel row"
    data-sw-carousel="true"
>

    {#
        Thumbnail previews
        ===========================================
    #}
    <div class="cms-block-image-carousel-thumbnails col-md-auto d-none d-md-block">
        {%- for image in element.data.sliderItems -%}
            <a href="#carousel-item-{{ loop.index }}" data-slide-to="{{ loop.index }}" class="cms-block-image-carousel-thumbnail-item{% if loop.index == 1 %} active{% endif %}">
                {%- sw_thumbnails 'gallery-slider-image-thumbnails' with {
                    media: image.media,
                    sizes: {
                        default: '70px'
                    },
                    attributes: {
                        loading: 'lazy',
                    }
                } -%}
            </a>
        {%- endfor -%}
    </div>

    <div class="col-md cms-element-carousel-items">
        {#
            Carousel items
            ===========================================
        #}
        <div class="cms-block-image-carousel-inner">
            {% for image in element.data.sliderItems %}
                <div class="cms-block-image-carousel-item" id="carousel-item-{{ loop.index }}">
                    {%- sw_thumbnails 'gallery-slider-image-thumbnails' with {
                        media: image.media,
                        autoColumnSizes: false,
                        attributes: {
                            loading: 'lazy',
                            'data-bs-toggle': 'modal',
                            'data-bs-target': "#gallery-modal",
                        }
                    } -%}
                </div>
            {% endfor %}
        </div>

        {#
            Arrow navigation
            ===========================================
        #}
        <div class="cms-element-carousel-arrows">
            <button class="cms-element-carousel-arrow prev" type="button">
                {% sw_icon 'arrow-left' style { size: 'sm' } %}
            </button>

            <button class="cms-element-carousel-arrow next" type="button">
                {% sw_icon 'arrow-right' style { size: 'sm' } %}
            </button>
        </div>

        {#
            Dot navigation
            ===========================================
        #}
        <div class="cms-block-image-carousel-navigation">
            {%- for image in element.data.sliderItems -%}
                <a class="cms-block-image-carousel-navigation-item{% if loop.index == 1 %} active{% endif %}" href="#carousel-item-{{ loop.index }}" data-slide-to="{{ loop.index }}">
                    <span class="visually-hidden">{{ loop.index }}</span>
                </a>
            {%- endfor -%}
        </div>
    </div>
</div>
{% endset %}

{{ carouselComponent }}

{#
    Full screen gallery
    ===========================================
#}
<div class="modal fade preview-modal" id="gallery-modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <button type="button" class="btn-close position-absolute top-0 end-0 z-5 m-3" data-bs-dismiss="modal" aria-label="Close"></button>

            <div class="modal-body overflow-hidden">
                {{ carouselComponent }}
            </div>
        </div>
    </div>
</div>
