<div class="cms-block-image-carousel row" data-sw-carousel="true">

    {#
        Thumbnail previews
    #}
    <div class="cms-block-image-carousel-thumbnails col-md-auto d-none d-md-block">
        {% for image in element.data.sliderItems %}
            <a href="#carousel-item-{{ loop.index }}"
               data-slide-to="{{ loop.index }}"
               class="cms-block-image-carousel-thumbnail-item">
                {% sw_thumbnails 'gallery-slider-image-thumbnails' with {
                    media: image.media,
                    sizes: {
                        default: '70px'
                    },
                    attributes: {
                        loading: 'lazy',
                    }
                } %}
            </a>
        {% endfor %}
    </div>

    {#
        Carousel items
    #}
    <div class="col-md cms-element-carousel-items">
        <div class="cms-block-image-carousel-inner">
            {% for image in element.data.sliderItems %}
                <div class="cms-block-image-carousel-item" id="carousel-item-{{ loop.index }}">
                    <img tabindex="0" src="{{ image.media.url }}" alt="{{ image.media.alt }}" loading="lazy">
                </div>
            {% endfor %}
        </div>


        <div class="cms-element-carousel-arrows">
            <button class="cms-element-carousel-arrow left" type="button">{% sw_icon 'arrow-left' style { size: 'sm' } %}</button>
            <button class="cms-element-carousel-arrow right" type="button">{% sw_icon 'arrow-right' style { size: 'sm' } %}</button>
        </div>

        {#
            Dot-Navigation
        #}
        <div class="cms-block-image-carousel-navigation">
            {% for image in element.data.sliderItems %}
                <a class="cms-block-image-carousel-navigation-item {% if loop.index == 1 %} active{% endif %}"
                   href="#carousel-item-{{ loop.index }}"
                   data-slide-to="{{ loop.index }}">
                    <span class="visually-hidden">{{ loop.index }}</span>
                </a>
            {% endfor %}
        </div>
    </div>

    <script defer>
        return;
        const dots = document.querySelectorAll('.cms-block-image-carousel-navigation-item');
        const dotsWrapper = document.querySelector('.cms-block-image-carousel-navigation');

        const thumbnails = document.querySelectorAll('.cms-block-image-carousel-thumbnail-item');

        let slideIndex = 1;

        function updateActiveDot() {
            dots.forEach((dot) => {
                dot.classList.remove('active');
            });

            const activeDot = dotsWrapper.querySelector(`[data-slide-to="${slideIndex}"]`);
            activeDot.classList.add('active');
        }

        document.querySelector('.cms-element-carousel-arrow.right').addEventListener('click', () => {

            slideIndex = slideIndex + 1;

            const targetEl = document.querySelector(`#carousel-item-${slideIndex}`);

            if (targetEl) {
                targetEl.scrollIntoView({block: "nearest", inline: "nearest"});
                updateActiveDot();
            }
        });

        document.querySelector('.cms-element-carousel-arrow.left').addEventListener('click', (e) => {
            if (slideIndex > 1) {
                slideIndex = slideIndex - 1;
            }

            const targetEl = document.querySelector(`#carousel-item-${slideIndex}`);

            if (targetEl) {
                targetEl.scrollIntoView({block: "nearest", inline: "nearest"});
                updateActiveDot();
            }
        });

        dots.forEach((dot) => {
            dot.addEventListener('click', (event) => {
                event.preventDefault();
                const targetIndex = Number(event.target.dataset.slideTo);
                const targetEl = document.querySelector(`#carousel-item-${targetIndex}`);

                slideIndex = targetIndex;

                if (targetEl) {
                    targetEl.scrollIntoView({block: "nearest", inline: "nearest"});
                }

                updateActiveDot();
            });
        });

        thumbnails.forEach((dot) => {
            dot.addEventListener('click', (event) => {
                event.preventDefault();
                const targetIndex = Number(event.currentTarget.dataset.slideTo);

                const targetEl = document.querySelector(`#carousel-item-${targetIndex}`);

                slideIndex = targetIndex;

                if (targetEl) {
                    targetEl.scrollIntoView({block: "nearest", inline: "nearest"});
                }

                updateActiveDot();
            });
        });


    </script>

</div>

