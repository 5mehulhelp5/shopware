        <h1 class="sw-admin-menu__shop-name">Acme Inc</h1>

        <p class="sw-admin-menu__version">Shopware Beyond (6.7.1)</p>
    </div>

    <template v-for="item in ITEMS">
        <component
            class="sw-admin-menu__item"
            :key="item.id"
            :is="!!item.to ? 'router-link' : 'button'"
            :to="item?.to ? { name: item.to } : undefined"
            :aria-expanded="item.to ? undefined : idOfExpandedItem === item.id"
            @click="expandItem(item.id)"
        >
            <mt-icon :name="`regular-${item.icon}`" size="var(--scale-size-16)" aria-hidden="true" />

            <span>{{ item.name }}</span>
        </component>

        <template v-if="item.children && idOfExpandedItem === item.id">
            <router-link
                v-for="child in item.children"
                :key="child.id" class="sw-admin-menu__item"
                :to="{ name: child.to }"
                style="padding-left: calc(10px + 16px + 10px * 1)"
            >
                {{ child.name }}
            </router-link>
        </template>
    </template>
</div>